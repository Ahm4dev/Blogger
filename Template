<script>
//<![CDATA[
/**
 * Blog Template - Optimized Script
 * Version: 2.0
 * Features: Theme System, Dark Mode, Infinite Scroll, Keyboard Navigation, Mobile Tables
 */

// ============================================================================
// Global State Management
// ============================================================================
const BlogState = {
  initialized: false,
  isSidebarOpen: false,
  isHeaderVisible: true,
  lastScrollY: 0,
  headerHeight: 80,
  isLoading: false,
  hasMorePosts: true,
  postsPerPage: 5,
  postsLoaded: 0,
  currentCategory: 'all',
  currentKeyboardIndex: -1,
  filteredLinks: []
};

// ============================================================================
// Theme Management System
// ============================================================================
const ThemeManager = {
  availableThemes: ['teal', 'orange', 'blue', 'green', 'purple', 'pink'],
  
  init() {
    const themeToggle = document.getElementById('themeToggle');
    const themePalette = document.getElementById('themePalette');
    const themeOptions = document.querySelectorAll('.theme-color-option');
    const html = document.documentElement;
    
    if (!themeToggle || !themePalette) return;
    
    const savedTheme = localStorage.getItem('blogTheme') || 'teal';
    this.applyTheme(savedTheme);
    
    themeToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      themePalette.classList.toggle('open');
    });
    
    themeOptions.forEach(option => {
      option.addEventListener('click', () => {
        const selectedTheme = option.dataset.theme;
        this.applyTheme(selectedTheme);
        this.updateActiveTheme(selectedTheme);
        themePalette.classList.remove('open');
      });
    });
    
    document.addEventListener('click', (e) => {
      if (!themeToggle.contains(e.target) && !themePalette.contains(e.target)) {
        themePalette.classList.remove('open');
      }
    });
    
    this.updateActiveTheme(savedTheme);
  },
  
  applyTheme(themeName) {
    if (!this.availableThemes.includes(themeName)) {
      themeName = 'orange';
    }
    
    document.documentElement.setAttribute('data-theme', themeName);
    localStorage.setItem('blogTheme', themeName);
    this.updateThemeMeta(themeName);
  },
  
  updateActiveTheme(themeName) {
    document.querySelectorAll('.theme-color-option').forEach(option => {
      option.classList.toggle('active', option.dataset.theme === themeName);
    });
  },
  
  updateThemeMeta(themeName) {
    const themeColors = {
      teal: '#009688',
      blue: '#2962FF',
      green: '#00C853',
      purple: '#7C4DFF',
      pink: '#FF4081',
      orange: '#FF6D00'
    };
	
	  
	   
    let themeMeta = document.querySelector('meta[name="theme-color"]');
    if (!themeMeta) {
      themeMeta = document.createElement('meta');
      themeMeta.name = 'theme-color';
      document.head.appendChild(themeMeta);
    }
    themeMeta.content = themeColors[themeName] || themeColors.orange;
  }
};

// ============================================================================
// Dark Mode Management - SAFE VERSION
// ============================================================================
const DarkModeManager = {
  init() {
    const modeToggle = document.getElementById('modeToggle');
    if (!modeToggle) return;
    
    const savedDarkMode = localStorage.getItem('darkMode');
    this.applyDarkMode(savedDarkMode === 'enabled');
    
    modeToggle.addEventListener('click', () => {
      const isDark = !document.body.classList.contains('dark-mode');
      this.applyDarkMode(isDark);
    });
  },
  
  applyDarkMode(isDark) {
    const html = document.documentElement;
    const body = document.body;
    const modeToggle = document.getElementById('modeToggle');
    
    if (isDark) {
      html.classList.add('dark-mode');
      body.classList.add('dark-mode');
      if (modeToggle) modeToggle.textContent = '☀️ Light Mode';
      localStorage.setItem('darkMode', 'enabled');
    } else {
      html.classList.remove('dark-mode');
      body.classList.remove('dark-mode');
      if (modeToggle) modeToggle.textContent = '🌙 Dark Mode';
      localStorage.removeItem('darkMode');
    }
  }
};

// ============================================================================
// Header Scroll Management
// ============================================================================
const HeaderManager = {
  init() {
    const header = document.querySelector('nav');
    if (!header) return;
    
    BlogState.headerHeight = header.offsetHeight;
    let ticking = false;
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          this.handleVisibility();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  },
  
// في HeaderManager.handleVisibility()
handleVisibility() {
  const header = document.querySelector('nav');
  if (!header) return;
  
  // إذا كان الهيدر محميًا بواسطة الماوس، لا تخفيه
  if (BlogState.isHeaderHovered || BlogState.isSidebarOpen) {
    header.style.transform = 'translateY(0)';
    BlogState.isHeaderVisible = true;
    return;
  }
  
  const currentScrollY = window.scrollY;
  const scrollDirection = currentScrollY > BlogState.lastScrollY ? 'down' : 'up';
  
  if (scrollDirection === 'down' && currentScrollY > BlogState.headerHeight && BlogState.isHeaderVisible) {
    header.style.transform = 'translateY(-100%)';
    BlogState.isHeaderVisible = false;
  } else if (scrollDirection === 'up' && !BlogState.isHeaderVisible) {
    header.style.transform = 'translateY(0)';
    BlogState.isHeaderVisible = true;
  }
  
  if (currentScrollY <= BlogState.headerHeight && !BlogState.isHeaderVisible) {
    header.style.transform = 'translateY(0)';
    BlogState.isHeaderVisible = true;
  }
  
  BlogState.lastScrollY = currentScrollY;
}
};

// ============================================================================
// Sidebar Management
// ============================================================================
const SidebarManager = {
  init() {
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    
    if (!menuToggle || !sidebar) return;
    
    menuToggle.addEventListener('click', () => this.toggle());
    
    document.addEventListener('click', (e) => {
      if (sidebar.classList.contains('open') && 
          !sidebar.contains(e.target) && 
          e.target !== menuToggle) {
        this.close();
      }
    });
    
    this.loadNavigation();
    this.createLabels();
  },
  
  toggle() {
    const sidebar = document.getElementById('sidebar');
    const menuToggle = document.getElementById('menuToggle');
    const header = document.querySelector('nav');
    
    const isOpen = sidebar.classList.toggle('open');
    menuToggle.classList.toggle('active');
    menuToggle.setAttribute('aria-expanded', isOpen);
    
    BlogState.isSidebarOpen = isOpen;
    
    if (isOpen && !BlogState.isHeaderVisible && header) {
      header.style.transform = 'translateY(0)';
      BlogState.isHeaderVisible = true;
    }
    
    if (isOpen && window.innerWidth > 768) {
      setTimeout(() => {
        const searchInput = document.getElementById('sidebarSearch');
        if (searchInput) {
          searchInput.focus();
          const length = searchInput.value.length;
          searchInput.setSelectionRange(length, length);
        }
      }, 300);
    }
  },
  
  open(pressedKey = '') {
    const sidebar = document.getElementById('sidebar');
    const menuToggle = document.getElementById('menuToggle');
    const searchInput = document.getElementById('sidebarSearch');
    const header = document.querySelector('nav');
    
    if (!sidebar || !searchInput) return;
    
    if (!sidebar.classList.contains('open')) {
      sidebar.classList.add('open');
      if (menuToggle) {
        menuToggle.classList.add('active');
        menuToggle.setAttribute('aria-expanded', 'true');
      }
      
      BlogState.isSidebarOpen = true;
      
      if (header) {
        header.style.transform = 'translateY(0)';
        BlogState.isHeaderVisible = true;
      }
    }
    
    setTimeout(() => {
      searchInput.focus();
      searchInput.classList.add('global-search-active');
      setTimeout(() => searchInput.classList.remove('global-search-active'), 500);
      
      if (pressedKey && pressedKey.length === 1) {
        searchInput.value += pressedKey;
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
      
      KeyboardNav.reset();
      KeyboardNav.updateFilteredLinks();
    }, 150);
  },
  
  close() {
    const sidebar = document.getElementById('sidebar');
    const menuToggle = document.getElementById('menuToggle');
    const searchInput = document.getElementById('sidebarSearch');
    
    if (sidebar && sidebar.classList.contains('open')) {
      sidebar.classList.remove('open');
      if (menuToggle) {
        menuToggle.classList.remove('active');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
      
      BlogState.isSidebarOpen = false;
      
      if (searchInput) {
        searchInput.value = '';
        searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
      
      KeyboardNav.reset();
    }
  },
  
  async loadNavigation() {
    const sidebarContent = document.getElementById('sidebarContent');
    if (!sidebarContent) return;
    
    const loadingElement = document.createElement('div');
    loadingElement.textContent = 'Loading posts...';
    loadingElement.style.cssText = 'padding: 1rem; text-align: center;';
    sidebarContent.innerHTML = '';
    sidebarContent.appendChild(loadingElement);
    
    try {
      const allPosts = await this.fetchPostsLazy();
      this.processPosts({ feed: { entry: allPosts } });
    } catch (error) {
      console.error('Error loading sidebar posts:', error);
      loadingElement.textContent = 'Error loading posts. Please refresh.';
    }
  },
  
  async fetchPostsLazy() {
    let allPosts = [];
    let startIndex = 1;
    const maxResults = 25;
    const maxPostsForSidebar = 1000;
    let hasMore = true;
    
    while (hasMore && allPosts.length < maxPostsForSidebar) {
      try {
        const url = `/feeds/posts/default?alt=json&start-index=${startIndex}&max-results=${maxResults}`;
        const response = await fetch(url);
        
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        
        const data = await response.json();
        const posts = data.feed.entry || [];
        
        if (posts.length === 0) {
          hasMore = false;
          break;
        }
        
        allPosts = allPosts.concat(posts);
        startIndex += maxResults;
        
        const loadingMsg = document.querySelector('.sidebar-content > div:first-child');
        if (loadingMsg && loadingMsg.textContent.includes('Loading')) {
          loadingMsg.textContent = `Loading posts... (${allPosts.length})`;
        }
        
        await new Promise(resolve => setTimeout(resolve, 50));
      } catch (error) {
        if (startIndex === 1) throw error;
        hasMore = false;
      }
    }
    
    return allPosts;
  },
  
  processPosts(data) {
    const posts = data.feed.entry || [];
    const fragment = document.createDocumentFragment();
    const section = document.createElement('div');
    section.className = 'sidebar-section';
    
    posts.forEach(post => {
      const postId = post.id.$t.split('-').pop();
      const title = post.title.$t;
      const postUrl = post.link.find(link => link.rel === 'alternate').href;
      const tags = post.category ? post.category.map(cat => cat.term) : [];
      
      const link = document.createElement('a');
      link.href = postUrl;
      link.className = 'sidebar-link';
      link.textContent = title;
      link.dataset.target = 'post-' + postId;
      link.dataset.tags = tags.join(',');
      
      section.appendChild(link);
    });
    
    fragment.appendChild(section);
    const sidebarContent = document.getElementById('sidebarContent');
    if (sidebarContent) {
      sidebarContent.innerHTML = '';
      sidebarContent.appendChild(fragment);
    }
    
    ScrollSpy.init();
    SmoothScroll.init();
    SearchManager.init();
  },
  
  async createLabels() {
    const labelsContainer = document.getElementById('sidebarLabels');
    if (!labelsContainer) return;
    
    labelsContainer.innerHTML = "<div style='padding:10px; text-align:center;'>Loading labels...</div>";
    
    try {
      const categories = await CategoryManager.fetchAll();
      labelsContainer.innerHTML = "";
      
      const allBtn = document.createElement("div");
      allBtn.className = "sidebar-label-btn active";
      allBtn.textContent = "All";
      allBtn.dataset.category = "all";
      labelsContainer.appendChild(allBtn);
      
      allBtn.addEventListener("click", () => {
        document.querySelectorAll(".sidebar-label-btn").forEach(b => b.classList.remove("active"));
        allBtn.classList.add("active");
        document.querySelectorAll(".sidebar-link").forEach(link => link.classList.remove("hidden"));
      });
      
      categories.forEach(category => {
        const btn = document.createElement("div");
        btn.className = "sidebar-label-btn";
        btn.textContent = category;
        btn.dataset.category = category;
        
        btn.addEventListener("click", () => {
          document.querySelectorAll(".sidebar-label-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          
          document.querySelectorAll(".sidebar-link").forEach(link => {
            const tags = link.dataset.tags ? link.dataset.tags.split(",") : [];
            link.classList.toggle("hidden", !tags.includes(category));
          });
        });
        
        labelsContainer.appendChild(btn);
      });
    } catch (error) {
      console.error('Error creating sidebar labels:', error);
      labelsContainer.innerHTML = "<div style='padding:10px; text-align:center; color: #ff4444;'>Error loading labels</div>";
    }
  }
};

// ============================================================================
// Search Management
// ============================================================================
const SearchManager = {
  init() {
    const searchInput = document.getElementById('sidebarSearch');
    if (!searchInput) return;
    
    const links = Array.from(document.querySelectorAll('.sidebar-link'));
    const postTags = {};
    
    links.forEach(link => {
      const postId = link.dataset.target;
      postTags[postId] = link.dataset.tags ? link.dataset.tags.split(',') : [];
    });
    
    searchInput.addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase().trim();
      let resultsCount = 0;
      
      window.requestAnimationFrame(() => {
        links.forEach(link => {
          const text = link.textContent.toLowerCase();
          const postId = link.dataset.target;
          const tags = postTags[postId] || [];
          
          const isMatch = text.includes(searchTerm) || 
                         tags.some(tag => tag.toLowerCase().includes(searchTerm));
          
          link.classList.toggle('hidden', !isMatch);
          if (isMatch) resultsCount++;
        });
        
        const noResults = document.getElementById('noResults');
        if (noResults) {
          noResults.classList.toggle('show', resultsCount === 0 && searchTerm !== '');
        }
        
        KeyboardNav.updateFilteredLinks();
      });
    });
  }
};

// ============================================================================
// Keyboard Navigation
// ============================================================================
const KeyboardNav = {
  init() {
    const searchInput = document.getElementById('sidebarSearch');
    if (!searchInput) return;
    
    searchInput.addEventListener('input', () => {
      this.reset();
      this.updateFilteredLinks();
    });
    
    searchInput.addEventListener('keydown', (e) => this.handleKeydown(e));
    
    document.addEventListener('click', (e) => {
      if (e.target !== searchInput) this.reset();
    });
  },
  
  handleKeydown(e) {
    const visibleLinks = this.getVisibleLinks();
    
    switch(e.key) {
      case 'ArrowDown':
        e.preventDefault();
        this.navigate(1, visibleLinks);
        break;
      case 'ArrowUp':
        e.preventDefault();
        this.navigate(-1, visibleLinks);
        break;
      case 'Enter':
        e.preventDefault();
        this.activateSelected(visibleLinks);
        break;
      case 'Escape':
        this.reset();
        document.getElementById('sidebarSearch').blur();
        break;
    }
  },
  
  navigate(direction, visibleLinks) {
    if (visibleLinks.length === 0) return;
    
    if (BlogState.currentKeyboardIndex >= 0 && BlogState.currentKeyboardIndex < visibleLinks.length) {
      visibleLinks[BlogState.currentKeyboardIndex].classList.remove('keyboard-selected');
    }
    
    BlogState.currentKeyboardIndex += direction;
    
    if (BlogState.currentKeyboardIndex < 0) {
      BlogState.currentKeyboardIndex = visibleLinks.length - 1;
    } else if (BlogState.currentKeyboardIndex >= visibleLinks.length) {
      BlogState.currentKeyboardIndex = 0;
    }
    
    const selectedLink = visibleLinks[BlogState.currentKeyboardIndex];
    selectedLink.classList.add('keyboard-selected');
    this.scrollToSelected(selectedLink);
  },
  
  activateSelected(visibleLinks) {
    let linkToActivate;
    
    if (BlogState.currentKeyboardIndex >= 0 && BlogState.currentKeyboardIndex < visibleLinks.length) {
      linkToActivate = visibleLinks[BlogState.currentKeyboardIndex];
    } else if (visibleLinks.length > 0) {
      linkToActivate = visibleLinks[0];
      linkToActivate.classList.add('keyboard-selected');
    } else {
      return;
    }
    
    if (linkToActivate.href) {
      window.location.href = linkToActivate.href;
    }
  },
  
  getVisibleLinks() {
    return Array.from(document.querySelectorAll('.sidebar-link:not(.hidden)'));
  },
  
  updateFilteredLinks() {
    BlogState.filteredLinks = this.getVisibleLinks();
    this.reset();
    
    if (BlogState.filteredLinks.length > 0) {
      BlogState.currentKeyboardIndex = 0;
      BlogState.filteredLinks[0].classList.add('keyboard-selected');
    }
  },
  
  reset() {
    BlogState.currentKeyboardIndex = -1;
    document.querySelectorAll('.sidebar-link.keyboard-selected').forEach(link => {
      link.classList.remove('keyboard-selected');
    });
  },
  
  scrollToSelected(selectedLink) {
    const sidebarContent = document.getElementById('sidebarContent');
    if (!sidebarContent) return;
    
    const linkRect = selectedLink.getBoundingClientRect();
    const sidebarRect = sidebarContent.getBoundingClientRect();
    
    const isAbove = linkRect.top < sidebarRect.top;
    const isBelow = linkRect.bottom > sidebarRect.bottom;
    
    if (isAbove || isBelow) {
      const elementOffset = selectedLink.offsetTop;
      const middleOffset = elementOffset - (sidebarContent.offsetHeight / 2) + (selectedLink.offsetHeight / 2);
      
      sidebarContent.scrollTo({
        top: middleOffset,
        behavior: 'smooth'
      });
    }
  }
};

// ============================================================================
// Global Keyboard Shortcuts
// ============================================================================
const GlobalKeyboard = {
  init() {
    document.addEventListener('keydown', (e) => this.handleKeydown(e));
  },
  
  handleKeydown(e) {
    if (e.key === 'Escape') {
      SidebarManager.close();
      e.preventDefault();
      return;
    }
    
    if (e.ctrlKey || e.altKey || e.metaKey || 
        e.key === 'Control' || e.key === 'Alt' || e.key === 'Meta' ||
        e.target.tagName === 'INPUT' || 
        e.target.tagName === 'TEXTAREA' ||
        e.target.isContentEditable) {
      return;
    }
    
    const allowedKeys = /^[a-zA-Z0-9\u0600-\u06FF\s]$/;
    
    if (!allowedKeys.test(e.key)) return;
    
    SidebarManager.open(e.key);
    e.preventDefault();
  }
};

// ============================================================================
// Scroll Spy
// ============================================================================
const ScrollSpy = {
  init() {
    const links = document.querySelectorAll('.sidebar-link');
    if (links.length === 0) return;
    
    const offset = 100;
    let ticking = false;
    let lastActiveLink = null;
    
    const onScroll = () => {
      const scrollPosition = window.scrollY + offset;
      let lastPassed = null;
      
      document.querySelectorAll('.post-card').forEach(post => {
        const postTop = post.offsetTop;
        if (postTop <= scrollPosition) {
          lastPassed = post.id;
        }
      });
      
      if (!lastPassed) {
        if (window.location.pathname === "/") {
          const firstPost = document.querySelector('.post-card');
          if (firstPost) lastPassed = firstPost.id;
        } else {
          const currentPostId = window.location.pathname.split('/').pop();
          lastPassed = 'post-' + currentPostId;
        }
      }
      
      links.forEach(link => {
        const isActive = link.dataset.target === lastPassed || 
                        link.href === window.location.href || 
                        link.href.endsWith(lastPassed.replace('post-', ''));
        
        link.classList.toggle('active', isActive);
        
        if (isActive && link !== lastActiveLink) {
          lastActiveLink = link;
          this.autoScrollSidebar(link);
        }
      });
    };
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          onScroll();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
    
    onScroll();
  },
  
  autoScrollSidebar(activeLink) {
    const sidebarContent = document.getElementById('sidebarContent');
    if (!sidebarContent) return;
    
    const linkRect = activeLink.getBoundingClientRect();
    const sidebarRect = sidebarContent.getBoundingClientRect();
    
    const isAbove = linkRect.top < sidebarRect.top;
    const isBelow = linkRect.bottom > sidebarRect.bottom;
    
    if (isAbove || isBelow) {
      const elementOffset = activeLink.offsetTop;
      const middleOffset = elementOffset - (sidebarContent.offsetHeight / 2) + (activeLink.offsetHeight / 2);
      
      sidebarContent.scrollTo({
        top: middleOffset,
        behavior: 'smooth'
      });
    }
  }
};

// ============================================================================
// Smooth Scrolling
// ============================================================================
const SmoothScroll = {
  init() {
    document.querySelectorAll('.sidebar-link').forEach(link => {
      link.addEventListener('click', function(e) {
        if (this.hash && document.querySelector(this.hash)) {
          e.preventDefault();
          
          const targetElement = document.querySelector(this.hash);
          if (targetElement) {
            const offset = 80;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = window.pageYOffset + elementPosition - offset;
            
            window.scrollTo({
              top: offsetPosition,
              behavior: 'smooth'
            });
            
            history.pushState(null, null, this.hash);
            
            const sidebar = document.getElementById('sidebar');
            const menuToggle = document.getElementById('menuToggle');
            if (sidebar && sidebar.classList.contains('open')) {
              sidebar.classList.remove('open');
              if (menuToggle) {
                menuToggle.classList.remove('active');
                menuToggle.setAttribute('aria-expanded', 'false');
              }
              BlogState.isSidebarOpen = false;
            }
          }
        }
      });
    });
  }
};

// ============================================================================
// Category Management
// ============================================================================
const CategoryManager = {
  async fetchAll() {
    try {
      let allCategories = new Set();
      let startIndex = 1;
      const maxResults = 50;
      let hasMore = true;
      
      while (hasMore) {
        try {
          const response = await fetch(
            `/feeds/posts/summary?alt=json&start-index=${startIndex}&max-results=${maxResults}`
          );
          if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
          
          const data = await response.json();
          const posts = data.feed.entry || [];
          
          if (posts.length === 0) {
            hasMore = false;
            break;
          }
          
          posts.forEach(post => {
            if (post.category) {
              post.category.forEach(cat => allCategories.add(cat.term));
            }
          });
          
          startIndex += maxResults;
          await new Promise(resolve => setTimeout(resolve, 50));
        } catch (error) {
          hasMore = false;
        }
      }
      
      return Array.from(allCategories).sort();
    } catch (error) {
      console.error('Error fetching categories:', error);
      return [];
    }
  },
  
  async createButtons(categories = null) {
    let categoriesContainer = document.querySelector('.categories-container');
    
    if (!categoriesContainer) {
      if (window.location.pathname !== "/" && !window.location.pathname.startsWith("/search/label/")) return;
      
      const categoriesFilter = document.createElement('div');
      categoriesFilter.className = 'categories-filter';
      categoriesFilter.id = 'categoriesFilter';
      
      categoriesContainer = document.createElement('div');
      categoriesContainer.className = 'categories-container';
      
      categoriesFilter.appendChild(categoriesContainer);
      
      const mainContent = document.getElementById('mainContent');
      if (mainContent) {
        mainContent.insertBefore(categoriesFilter, mainContent.firstChild);
      } else {
        return;
      }
    }
    
    if (!categories) {
      categories = await this.fetchAll();
    }
    
    categoriesContainer.innerHTML = '';
    
    const allButton = document.createElement('div');
    allButton.className = 'category-btn active';
    allButton.textContent = 'All';
    allButton.dataset.category = 'all';
    categoriesContainer.appendChild(allButton);
    
    categories.forEach(category => {
      const button = document.createElement('div');
      button.className = 'category-btn';
      button.textContent = category;
      button.dataset.category = category;
      categoriesContainer.appendChild(button);
    });
    
    if (categories.length === 0) {
      const categoriesFilter = document.getElementById('categoriesFilter');
      if (categoriesFilter) categoriesFilter.style.display = 'none';
    }
    
    this.setupFilters();
    this.activateCurrent();
  },
  
  setupFilters() {
    const categoryButtons = document.querySelectorAll('.category-btn');
    
    categoryButtons.forEach(button => {
      const newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);
    });
    
    const newCategoryButtons = document.querySelectorAll('.category-btn');
    
    newCategoryButtons.forEach(button => {
      button.addEventListener('click', function() {
        if (BlogState.isLoading) return;
        
        newCategoryButtons.forEach(btn => btn.classList.remove('active'));
        this.classList.add('active');
        
        const newCategory = this.dataset.category;
        
        if (window.location.pathname.startsWith("/search/label/")) {
          if (newCategory !== 'all') {
            const newUrl = `/search/label/${encodeURIComponent(newCategory)}`;
            window.history.pushState({}, '', newUrl);
          } else {
            window.history.pushState({}, '', '/');
          }
        }
        
        PostLoader.loadCategory(newCategory, true);
      });
    });
  },
  
  activateCurrent() {
    const categoryButtons = document.querySelectorAll('.category-btn');
    
    if (window.location.pathname.startsWith("/search/label/")) {
      const labelMatch = window.location.pathname.match(/\/search\/label\/([^/?]+)/);
      if (labelMatch) {
        const currentCategory = decodeURIComponent(labelMatch[1].replace(/\+/g, ' '));
        const matchingButton = Array.from(categoryButtons).find(btn => 
          btn.dataset.category === currentCategory
        );
        
        if (matchingButton) {
          categoryButtons.forEach(btn => btn.classList.remove('active'));
          matchingButton.classList.add('active');
        }
      }
    } else if (window.location.pathname === "/") {
      const allButton = document.querySelector('.category-btn[data-category="all"]');
      if (allButton) {
        categoryButtons.forEach(btn => btn.classList.remove('active'));
        allButton.classList.add('active');
      }
    }
  }
};

// ============================================================================
// Post Loader Management
// ============================================================================
const PostLoader = {
  async loadCategory(category, reset = false) {
    console.log('Loading category:', { category, reset, isLoading: BlogState.isLoading });
    
    if (BlogState.isLoading) {
      console.log('Already loading, skipping...');
      return;
    }
    
    BlogState.isLoading = true;
    BlogState.currentCategory = category;
    
    try {
      if (reset) {
        console.log('Resetting posts for category:', category);
        const mainContent = document.getElementById('mainContent');
        const loadingIndicator = document.createElement('div');
        loadingIndicator.className = 'loading-posts visible';
        loadingIndicator.innerHTML = "<div class='spinner'></div><p>Loading posts...</p>";
        mainContent.appendChild(loadingIndicator);
        BlogState.postsLoaded = 0;
        BlogState.hasMorePosts = true;
        
        const existingPosts = mainContent.querySelectorAll('.post-card');
        existingPosts.forEach(post => post.remove());
      }
      
      const startIndex = BlogState.postsLoaded + 1;
      console.log('Loading posts - startIndex:', startIndex, 'postsLoaded:', BlogState.postsLoaded);
      
      const categoryPath = category !== 'all' ? '/-/' + encodeURIComponent(category) : '';
      const apiUrl = `/feeds/posts/default${categoryPath}?alt=json&start-index=${startIndex}&max-results=${BlogState.postsPerPage}`;
      console.log('API URL:', apiUrl);
      
      const response = await fetch(apiUrl);
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const data = await response.json();
      console.log('API Response received, posts count:', data.feed?.entry?.length || 0);
      
      if (!data.feed || !data.feed.entry || data.feed.entry.length === 0) {
        console.log('No more posts available');
        BlogState.hasMorePosts = false;
        
        if (BlogState.postsLoaded === 0 && reset) {
          this.showNoPostsMessage();
        }
      } else {
        this.processPosts(data, reset);
      }
      
    } catch (error) {
      console.error('Error loading posts:', error);
      if (!reset) {
        this.showError('Error loading posts. Please try again.');
      }
    } finally {
      BlogState.isLoading = false;
      const loadingIndicator = document.querySelector('.loading-posts');
      if (loadingIndicator) loadingIndicator.remove();
      console.log('loadCategory finished, isLoading:', BlogState.isLoading);
    }
  },
  
  async fetchCategoriesAndPosts(category = 'all', reset = true) {
    if (BlogState.isLoading) return;
    
    BlogState.isLoading = true;
    BlogState.currentCategory = category;
    
    try {
      const mainContent = document.getElementById('mainContent');
      const loadingIndicator = document.createElement('div');
      loadingIndicator.className = 'loading-posts visible';
      loadingIndicator.innerHTML = "<div class='spinner'></div><p>Loading content...</p>";
      mainContent.appendChild(loadingIndicator);
      
      const [categories, initialPosts] = await Promise.all([
        CategoryManager.fetchAll(),
        fetch(`/feeds/posts/default${category !== 'all' ? '/-/' + encodeURIComponent(category) : ''}?alt=json&start-index=1&max-results=5`)
          .then(response => {
            if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
            return response.json();
          })
      ]);
      
      await CategoryManager.createButtons(categories);
      
      if (reset) {
        BlogState.postsLoaded = 0;
        BlogState.hasMorePosts = true;
        const existingPosts = mainContent.querySelectorAll('.post-card');
        existingPosts.forEach(post => post.remove());
      }
      
      this.processPosts(initialPosts, reset);
      loadingIndicator.remove();
      
    } catch (error) {
      console.error('Error loading content:', error);
      this.showError('Error loading content. Please refresh the page.');
    } finally {
      BlogState.isLoading = false;
    }
  },
  
  // دالة مساعدة للتحقق مما إذا كان المحتوى يحتوي على كود HTML
  containsHTMLCode(content) {
    if (!content) return false;
    
    // فقط إذا كان المحتوى يحتوي على كود برمجي واضح
    const codePatterns = [
      /<script\b[^>]*>[\s\S]*?<\/script>/gi,
      /<style\b[^>]*>[\s\S]*?<\/style>/gi,
      /<pre\b[^>]*>[\s\S]*?<\/pre>/gi,
      /<code\b[^>]*>[\s\S]*?<\/code>/gi,
      /&lt;(script|style|pre|code)[\s\S]*?&gt;/gi
    ];
    
    return codePatterns.some(pattern => pattern.test(content));
  },
  
  // دالة مساعدة لاستخراج نص عادي من HTML
  extractPlainText(htmlContent) {
    if (!htmlContent) return '';
    
    const tmp = document.createElement('div');
    tmp.innerHTML = htmlContent;
    
    // إزالة العناصر التي تحتوي على كود فقط
    const codeElements = tmp.querySelectorAll('script, style, pre, code');
    codeElements.forEach(el => el.remove());
    
    // الحصول على النص مع الحفاظ على المسافات
    let text = tmp.textContent || tmp.innerText || '';
    
    // تنظيف النص - إزالة المسافات الزائدة
    text = text.replace(/\s+/g, ' ').trim();
    
    // إذا كان النص طويلاً، أخذ جزء منه للمعاينة
    if (text.length > 130) {
      text = text.substring(0, 130) + '...';
    }
    
    return text;
  },
  
  processPosts(data, reset = false) {
    const posts = data.feed.entry || [];
    
    if (posts.length === 0) {
      BlogState.hasMorePosts = false;
      BlogState.isLoading = false;
      
      const loadingIndicator = document.querySelector('.loading-posts');
      if (loadingIndicator) loadingIndicator.remove();
      
      if (BlogState.postsLoaded === 0 && reset) {
        this.showNoPostsMessage();
      }
      return;
    }
    
    if (reset) {
      const mainContent = document.getElementById('mainContent');
      const existingPosts = mainContent.querySelectorAll('.post-card');
      existingPosts.forEach(post => post.remove());
      BlogState.postsLoaded = 0;
    }
    
    const fragment = document.createDocumentFragment();
    const mainContent = document.getElementById('mainContent');
    
    posts.forEach(post => {
      try {
        const postId = (post.id && post.id.$t) ? post.id.$t.split('-').pop() : ('p' + Date.now() + Math.random());
        const title = (post.title && post.title.$t) ? post.title.$t : 'Untitled';
        const linkObj = (post.link || []).find(l => l.rel === 'alternate') || null;
        const postUrl = linkObj ? linkObj.href : '#';
        const contentHtml = post.content ? post.content.$t : (post.summary ? post.summary.$t : '');
        const published = post.published ? new Date(post.published.$t).toLocaleDateString() : '';
        
        const categories = post.category || [];
        const firstCategory = categories.length > 0 ? categories[0].term : null;
        const categoryUrl = firstCategory ? '/search/label/' + encodeURIComponent(firstCategory) : '#';
        
        const postCard = document.createElement('div');
        postCard.className = 'post-card';
        postCard.id = 'post-' + postId;
        
        const headerDiv = document.createElement('div');
        headerDiv.className = 'post-header';
        const h2 = document.createElement('h2');
        h2.className = 'post-title';
        const titleLink = document.createElement('a');
        titleLink.className = 'post-title-link';
        titleLink.href = postUrl;
        titleLink.textContent = title;
        h2.appendChild(titleLink);
        const dateSpan = document.createElement('span');
        dateSpan.className = 'post-date';
        dateSpan.textContent = published;
        headerDiv.appendChild(h2);
        headerDiv.appendChild(dateSpan);
        
        const contentDiv = document.createElement('div');
        contentDiv.className = 'post-content';
        
        if (post.media$thumbnail && post.media$thumbnail.url) {
          const img = document.createElement('img');
          img.className = 'post-image';
          img.src = post.media$thumbnail.url;
          img.alt = title;
          img.loading = 'lazy';
          img.addEventListener('load', function() { img.classList.add('loaded'); });
          contentDiv.appendChild(img);
        }
        
        const previewDiv = document.createElement('div');
        previewDiv.className = 'post-preview';
        
        // التحقق مما إذا كان المحتوى يحتوي على كود HTML
        let previewText = '';
        if (contentHtml && !this.containsHTMLCode(contentHtml)) {
          // إذا كان المحتوى نصياً عادياً
          const plainText = this.extractPlainText(contentHtml);
          previewText = plainText;
        } else {
          // إذا كان المحتوى كود HTML، نعرض رسالة بديلة
          previewText = 'Click "Read More" to view the full content...';
        }
        
        previewDiv.textContent = previewText;
        
        contentDiv.appendChild(previewDiv);
        
        const footerDiv = document.createElement('div');
        footerDiv.className = 'post-footer';
        
        if (firstCategory) {
          const labelBtn = document.createElement('a');
          labelBtn.className = 'label-btn';
          labelBtn.href = categoryUrl;
          labelBtn.textContent = firstCategory;
          labelBtn.title = 'View all posts in ' + firstCategory;
          footerDiv.appendChild(labelBtn);
        }
        
        const readMoreA = document.createElement('a');
        readMoreA.className = 'read-more-btn';
        readMoreA.href = postUrl || '#';
        readMoreA.textContent = 'Read More';
        footerDiv.appendChild(readMoreA);
        
        postCard.appendChild(headerDiv);
        postCard.appendChild(contentDiv);
        postCard.appendChild(footerDiv);
        
        fragment.appendChild(postCard);
      } catch (err) {
        console.error('Error building post element', err, post);
      }
    });
    
    mainContent.appendChild(fragment);
    BlogState.postsLoaded += posts.length;
    
    const loadingIndicator = document.querySelector('.loading-posts');
    if (loadingIndicator) loadingIndicator.remove();
    
    setTimeout(() => TableManager.init(), 50);
    
    ScrollSpy.init();
    
    BlogState.isLoading = false;
    if (posts.length < BlogState.postsPerPage) {
      BlogState.hasMorePosts = false;
    }
  },
  
  showNoPostsMessage() {
    const mainContent = document.getElementById('mainContent');
    const noPostsMessage = document.createElement('div');
    noPostsMessage.className = 'loading-posts';
    noPostsMessage.innerHTML = '<p>No posts found in this category.</p>';
    mainContent.appendChild(noPostsMessage);
  },
  
  showError(message) {
    const mainContent = document.getElementById('mainContent');
    const errorDiv = document.createElement('div');
    errorDiv.className = 'loading-posts visible';
    errorDiv.innerHTML = `<p style="color: #ff4444;">${message}</p>`;
    mainContent.appendChild(errorDiv);
    
    setTimeout(() => errorDiv.remove(), 5000);
  }
};


// ============================================================================
// Infinite Scroll Management
// ============================================================================
const InfiniteScroll = {
  init() {
    let ticking = false;
    
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          this.check();
          ticking = false;
        });
        ticking = true;
      }
    }, { passive: true });
  },
  
  check() {
    if (BlogState.isLoading || !BlogState.hasMorePosts) return;
    
    const isHomePage = window.location.pathname === "/";
    const isLabelPage = window.location.pathname.startsWith("/search/label/");
    
    if (!isHomePage && !isLabelPage) return;
    
    const scrollPosition = window.pageYOffset;
    const documentHeight = document.documentElement.scrollHeight;
    const windowHeight = window.innerHeight;
    
    if (scrollPosition + windowHeight >= documentHeight - 500) {
      PostLoader.loadCategory(BlogState.currentCategory, false);
    }
  }
};

// ============================================================================
// Mobile Table Management
// ============================================================================
const TableManager = {
  init() {
    console.log('Initializing mobile table responsive system...');
    
    const tables = document.querySelectorAll('.post-body table');
    let tablesProcessed = 0;
    
    tables.forEach((table, index) => {
      if (table.closest('.mobile-table-container')) return;
      
      const container = document.createElement('div');
      container.className = 'mobile-table-container';
      container.setAttribute('data-table-index', index);
      
      table.parentNode.insertBefore(container, table);
      container.appendChild(table);
      
      tablesProcessed++;
    });
    
    console.log(`Processed ${tablesProcessed} tables for mobile responsiveness`);
  }
};

// ============================================================================
// Back to Top Button
// ============================================================================
const BackToTop = {
  init() {
    const backToTop = document.getElementById('backToTop');
    if (!backToTop) return;
    
    backToTop.addEventListener('click', (e) => {
      e.preventDefault();
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
    
    window.addEventListener('scroll', () => {
      backToTop.classList.toggle('visible', window.scrollY > 300);
    });
  }
};

// ============================================================================
// Hash Link Handler
// ============================================================================
const HashHandler = {
  init() {
    if (window.location.hash) {
      const targetElement = document.querySelector(window.location.hash);
      if (targetElement) {
        setTimeout(() => {
          const offset = 80;
          const elementPosition = targetElement.getBoundingClientRect().top;
          const offsetPosition = window.pageYOffset + elementPosition - offset;
          
          window.scrollTo({
            top: offsetPosition,
            behavior: 'smooth'
          });
        }, 100);
      }
    }
  }
};

// ============================================================================
// Page State Handler
// ============================================================================
const PageStateHandler = {
  init() {
    window.addEventListener('popstate', () => {
      setTimeout(() => {
        CategoryManager.activateCurrent();
        
        const activeButton = document.querySelector('.category-btn.active');
        const mainContent = document.getElementById('mainContent');
        if (activeButton && mainContent.querySelectorAll('.post-card').length === 0) {
          PostLoader.loadCategory(activeButton.dataset.category, true);
        }
      }, 100);
    });
  }
};

// ============================================================================
// Mobile Force Reflow
// ============================================================================
const MobileReflow = {
  init() {
    if ('ontouchstart' in window) {
      document.body.style.minHeight = window.innerHeight + 'px';
      window.addEventListener('resize', () => {
        document.body.style.minHeight = window.innerHeight + 'px';
      });
    }
  }
};

// ============================================================================
// Main Initialization
// ============================================================================
document.addEventListener('DOMContentLoaded', function() {
  // Prevent double initialization
  if (BlogState.initialized) return;
  BlogState.initialized = true;
  
  console.log('Initializing Blog Template...');
  
  // Initialize global state
  BlogState.lastScrollY = window.scrollY;
  
  // Initialize all modules
  ThemeManager.init();
  DarkModeManager.init();
  HeaderManager.init();
  SidebarManager.init();
  KeyboardNav.init();
  GlobalKeyboard.init();
  BackToTop.init();
  HashHandler.init();
  PageStateHandler.init();
  MobileReflow.init();
  
  // Initialize content loading for home and label pages
  if (window.location.pathname === "/" || window.location.pathname.startsWith("/search/label/")) {
    let targetCategory = 'all';
    if (window.location.pathname.startsWith("/search/label/")) {
      const labelMatch = window.location.pathname.match(/\/search\/label\/([^/?]+)/);
      if (labelMatch) {
        targetCategory = decodeURIComponent(labelMatch[1].replace(/\+/g, ' '));
      }
    }
    
    PostLoader.fetchCategoriesAndPosts(targetCategory, true).then(() => {
      console.log('Content loaded successfully');
    }).catch(error => {
      console.error('Error loading content:', error);
    });
  }
  
  // Initialize infinite scroll
  InfiniteScroll.init();
  
  console.log('Blog Template initialized successfully');
});

// Initialize mobile tables on window load
window.addEventListener('load', () => {
  TableManager.init();
});

// ============================================================================
// Header Hover Management
// ============================================================================
const HeaderHoverManager = {
  init() {
    const header = document.querySelector('nav');
    if (!header) return;
    
    let hoverTimeout;
    
    header.addEventListener('mouseenter', () => {
      clearTimeout(hoverTimeout);
      header.classList.add('hover-protected');
      BlogState.isHeaderHovered = true;
    });
    
    header.addEventListener('mouseleave', () => {
      hoverTimeout = setTimeout(() => {
        header.classList.remove('hover-protected');
        BlogState.isHeaderHovered = false;
        
        // إعادة التحقق من حالة التمرير بعد مغادرة الماوس
        if (window.scrollY > BlogState.headerHeight && !BlogState.isSidebarOpen) {
          header.style.transform = 'translateY(-100%)';
          BlogState.isHeaderVisible = false;
        }
      }, 300); // تأخير 300 مللي ثانية قبل إخفاء الهيدر
    });
  }
};
//]]>
</script>
</head>
