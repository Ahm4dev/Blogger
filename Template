    <meta charset='utf-8'/>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=yes' name='viewport'/>
    <title><data:blog.pageTitle/></title>

    <!-- ============================================
         SEO Meta Description and Keywords
         ============================================ -->
    <b:if cond='data:blog.pageType == "index"'>
        <meta name='description' content='Discover clear, comprehensive summaries of International Financial Reporting Standards (IFRS) and International Standards on Auditing (ISA). Essential resource for accountants, auditors, and finance students worldwide.'/>
    <b:elseif cond='data:blog.pageType == "item"'/>
        <meta expr:content='data:blog.metaDescription' name='description'/>
    <b:else/>
        <meta expr:content='data:blog.pageTitle' name='description'/>
    </b:if>

    <!-- Canonical URL -->
    <link rel='canonical' expr:href='data:blog.canonicalUrl'/>

    <!-- ============================================
         Open Graph Tags for Social Media Sharing
         ============================================ -->
    <meta property='og:site_name' expr:content='data:blog.title'/>
    <meta property='og:title' expr:content='data:blog.pageName'/>
    <meta property='og:url' expr:content='data:blog.canonicalUrl'/>
    <meta property='og:type' expr:content='data:blog.pageType == "item" ? "article" : "website"'/>
    <meta property='og:locale' content='en_US'/>
    
    <!-- Open Graph Description -->
    <b:if cond='data:blog.pageType == "index"'>
        <meta property='og:description' content='Discover clear, comprehensive summaries of International Financial Reporting Standards (IFRS) and International Standards on Auditing (ISA). Essential resource for accountants, auditors, and finance students worldwide.'/>
    <b:else/>
        <meta property='og:description' expr:content='data:blog.metaDescription ? data:blog.metaDescription : data:blog.pageName'/>
    </b:if>

    <!-- Open Graph Image with Fallback -->
    <b:if cond='data:blog.postImageUrl'>
        <meta property='og:image' expr:content='data:blog.postImageUrl'/>
        <meta property='og:image:secure_url' expr:content='data:blog.postImageUrl'/>
        <meta property='og:image:width' content='1200'/>
        <meta property='og:image:height' content='630'/>
        <meta property='og:image:type' content='image/jpeg'/>
        <meta property='og:image:alt' expr:content='data:blog.pageName'/>
    <b:else/>
        <meta property='og:image' content='https://live.staticflickr.com/65535/54929390696_1f547017e9_b.jpg'/>
        <meta property='og:image:secure_url' content='https://live.staticflickr.com/65535/54929390696_1f547017e9_b.jpg'/>
        <meta property='og:image:width' content='1024'/>
        <meta property='og:image:height' content='768'/>
        <meta property='og:image:type' content='image/jpeg'/>
        <meta property='og:image:alt' expr:content='data:blog.pageName'/>
    </b:if>

    <!-- Article-specific Open Graph tags -->
    <b:if cond='data:blog.pageType == "item"'>
        <meta property='article:published_time' expr:content='data:blog.postTimestamp'/>
        <meta property='article:modified_time' expr:content='data:blog.postTimestamp'/>
        <meta property='article:author' expr:content='data:blog.title'/>
    </b:if>

    <!-- ============================================
         Twitter Card Tags
         ============================================ -->
    <meta name='twitter:card' content='summary_large_image'/>
    <meta name='twitter:title' expr:content='data:blog.pageName'/>
    <meta name='twitter:description' expr:content='data:blog.metaDescription ? data:blog.metaDescription : data:blog.pageName'/>
    <b:if cond='data:blog.postImageUrl'>
        <meta name='twitter:image' expr:content='data:blog.postImageUrl'/>
        <meta name='twitter:image:alt' expr:content='data:blog.pageName'/>
    <b:else/>
        <meta name='twitter:image' content='https://live.staticflickr.com/65535/54929390696_1f547017e9_b.jpg'/>
        <meta name='twitter:image:alt' expr:content='data:blog.pageName'/>
    </b:if>

    <!-- ============================================
         Schema.org Structured Data (JSON-LD)
         ============================================ -->
    <b:if cond='data:blog.pageType == "item"'>
        <!-- BlogPosting Schema for Individual Posts -->
        <script type='application/ld+json'>
        {
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "mainEntityOfPage": {
                "@type": "WebPage",
                "@id": "<data:blog.canonicalUrl/>"
            },
            "headline": "<data:blog.pageName/>",
            "description": "<data:blog.metaDescription/>",
            "image": {
                "@type": "ImageObject",
                "url": "<b:if cond='data:blog.postImageUrl'><data:blog.postImageUrl/><b:else/>https://live.staticflickr.com/65535/54929390696_1f547017e9_b.jpg</b:if>",
                "width": "<b:if cond='data:blog.postImageUrl'>1200<b:else/>1024</b:if>",
                "height": "<b:if cond='data:blog.postImageUrl'>630<b:else/>768</b:if>"
            },
            "author": {
                "@type": "Person",
                "name": "<data:blog.title/>"
            },
            "publisher": {
                "@type": "Organization",
                "name": "<data:blog.title/>",
                "logo": {
                    "@type": "ImageObject",
                    "url": "<data:blog.blogspotFaviconUrl/>"
                }
            },
            "datePublished": "<data:blog.postTimestamp/>",
            "dateModified": "<data:blog.postTimestamp/>"
        }
        </script>
    <b:else/>
        <!-- Website Schema for Homepage/Archive Pages -->
        <script type='application/ld+json'>
        {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "@id": "<data:blog.canonicalUrl/>",
            "url": "<data:blog.canonicalUrl/>",
            "name": "<data:blog.title/>",
            "description": "Discover clear, comprehensive summaries of International Financial Reporting Standards (IFRS) and International Standards on Auditing (ISA). Essential resource for accountants, auditors, and finance students worldwide.",
            "publisher": {
                "@type": "Organization",
                "name": "<data:blog.title/>",
                "logo": {
                    "@type": "ImageObject",
                    "url": "<data:blog.blogspotFaviconUrl/>"
                }
            }
        }
        </script>
    </b:if>

    <!-- Organization Schema -->
    <script type='application/ld+json'>
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "<data:blog.title/>",
        "url": "<data:blog.homepageUrl/>",
        "logo": "<data:blog.blogspotFaviconUrl/>",
        "sameAs": []
    }
    </script>

